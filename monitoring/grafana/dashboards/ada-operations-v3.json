{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {"id": 1, "type": "row", "title": "ESTADO OPERATIVO", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}},
    {"id": 2, "type": "stat", "title": "Peticiones en el período", "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1}, "targets": [{"expr": "sum(increase(ada_requests_total[$__range]))"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "0"}}, "options": {"graphMode": "none", "colorMode": "value"}},
    {"id": 3, "type": "stat", "title": "Ritmo de peticiones", "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1}, "targets": [{"expr": "sum(rate(ada_requests_total[$__rate_interval])) * 60"}], "fieldConfig": {"defaults": {"unit": "reqpm", "decimals": 2, "noValue": "0 req/min"}}, "options": {"graphMode": "none", "colorMode": "value"}},
    {"id": 4, "type": "stat", "title": "Invocaciones LLM", "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1}, "targets": [{"expr": "sum(increase(ada_llm_duration_seconds_count[$__range]))"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "0"}}, "options": {"graphMode": "none", "colorMode": "value"}},
    {"id": 5, "type": "stat", "title": "CPU ADA", "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1}, "targets": [{"expr": "process_cpu_usage * 100"}], "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "noValue": "SIN DATOS", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "orange", "value": 70}, {"color": "red", "value": 90}]}}}, "options": {"graphMode": "none", "colorMode": "background"}},
    {"id": 6, "type": "stat", "title": "Heap ADA", "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1}, "targets": [{"expr": "sum(jvm_memory_used_bytes{area=\"heap\"})"}], "fieldConfig": {"defaults": {"unit": "bytes", "decimals": 1, "noValue": "0 B"}}, "options": {"graphMode": "none", "colorMode": "value"}},
    {"id": 7, "type": "stat", "title": "ADA disponible", "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1}, "targets": [{"expr": "max(up{job=\"ada\"})"}], "fieldConfig": {"defaults": {"unit": "short", "noValue": "SIN DATOS", "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}}, "options": {"graphMode": "none", "colorMode": "background"}},
    {"id": 8, "type": "row", "title": "ÚLTIMA PETICIÓN: TIEMPO REAL", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}},
    {"id": 9, "type": "stat", "title": "Duración total última petición", "gridPos": {"h": 4, "w": 6, "x": 0, "y": 6}, "targets": [{"expr": "ada_request_last_duration_seconds"}], "fieldConfig": {"defaults": {"unit": "s", "decimals": 2, "noValue": "SIN DATOS"}}, "options": {"graphMode": "none", "colorMode": "background"}},
    {"id": 10, "type": "stat", "title": "Peticiones en curso", "gridPos": {"h": 4, "w": 6, "x": 6, "y": 6}, "targets": [{"expr": "ada_requests_active"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "0"}}, "options": {"graphMode": "none", "colorMode": "background"}},
    {"id": 11, "type": "stat", "title": "Antigüedad del último dato", "gridPos": {"h": 4, "w": 6, "x": 12, "y": 6}, "targets": [{"expr": "(time() - ada_request_last_completed_at_epoch_seconds) and (ada_request_last_completed_at_epoch_seconds > 0)"}], "fieldConfig": {"defaults": {"unit": "s", "decimals": 1, "noValue": "SIN DATOS"}}, "options": {"graphMode": "none", "colorMode": "background"}},
    {"id": 12, "type": "stat", "title": "Errores de peticiones", "gridPos": {"h": 4, "w": 6, "x": 18, "y": 6}, "targets": [{"expr": "sum(increase(ada_requests_total{outcome!=\"success\"}[$__range]))"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "0"}}, "options": {"graphMode": "none", "colorMode": "background"}},
    {"id": 13, "type": "table", "title": "Duración de cada etapa de la última petición", "gridPos": {"h": 7, "w": 12, "x": 0, "y": 10}, "targets": [{"expr": "ada_pipeline_stage_last_duration_seconds", "format": "table", "instant": true}], "fieldConfig": {"defaults": {"unit": "s", "decimals": 3}}, "options": {"showHeader": true}},
    {"id": 14, "type": "timeseries", "title": "Duración promedio por etapa (histórico)", "gridPos": {"h": 7, "w": 12, "x": 12, "y": 10}, "targets": [{"expr": "sum by (stage) (rate(ada_pipeline_stage_duration_seconds_sum[$__rate_interval])) / sum by (stage) (rate(ada_pipeline_stage_duration_seconds_count[$__rate_interval]))", "legendFormat": "{{stage}}"}], "fieldConfig": {"defaults": {"unit": "s", "decimals": 3, "custom": {"showPoints": "never"}}}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 15, "type": "row", "title": "ROUTING Y CONTEXTO LLM", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 17}},
    {"id": 16, "type": "timeseries", "title": "Latencia por modelo", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18}, "targets": [{"expr": "sum by (model) (rate(ada_llm_duration_seconds_sum[$__rate_interval])) / sum by (model) (rate(ada_llm_duration_seconds_count[$__rate_interval]))", "legendFormat": "Promedio · {{model}}"}, {"expr": "max by (model) (ada_llm_duration_seconds_max)", "legendFormat": "Máximo · {{model}}"}], "fieldConfig": {"defaults": {"unit": "s", "decimals": 2, "custom": {"showPoints": "never"}}}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 17, "type": "timeseries", "title": "Contexto usado por modelo", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18}, "targets": [{"expr": "ada_llm_context_tokens_last", "legendFormat": "{{model}}"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "custom": {"showPoints": "never"}}}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 18, "type": "timeseries", "title": "Tokens por componente del contexto", "gridPos": {"h": 8, "w": 14, "x": 0, "y": 26}, "targets": [{"expr": "sum by (component) (rate(ada_llm_tokens_total[$__rate_interval])) * 60", "legendFormat": "{{component}} / min"}], "fieldConfig": {"defaults": {"unit": "short", "custom": {"fillOpacity": 35, "stacking": {"mode": "normal"}, "showPoints": "never"}}}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 19, "type": "table", "title": "Selección de contexto en el período", "gridPos": {"h": 8, "w": 10, "x": 14, "y": 26}, "targets": [{"expr": "sum by (type, item) (increase(ada_context_selection_items_total[$__range]))", "format": "table", "instant": true}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}}, "options": {"showHeader": true}},
    {"id": 20, "type": "timeseries", "title": "Tokens del proveedor: entrada vs salida", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 34}, "targets": [{"expr": "sum by (direction, model) (rate(ada_llm_provider_tokens_total[$__rate_interval])) * 60", "legendFormat": "{{model}} · {{direction}} / min"}], "fieldConfig": {"defaults": {"unit": "short", "custom": {"showPoints": "never"}}}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 21, "type": "timeseries", "title": "Latencia del selector 1B", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 34}, "targets": [{"expr": "sum by (model) (rate(ada_context_selection_duration_seconds_sum[$__rate_interval])) / sum by (model) (rate(ada_context_selection_duration_seconds_count[$__rate_interval]))", "legendFormat": "{{model}}"}], "fieldConfig": {"defaults": {"unit": "s", "decimals": 2, "custom": {"showPoints": "never"}}}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 22, "type": "row", "title": "MCP Y TOOLS", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 42}},
    {"id": 23, "type": "stat", "title": "Invocaciones MCP", "gridPos": {"h": 4, "w": 6, "x": 0, "y": 43}, "targets": [{"expr": "sum(increase(ada_mcp_calls_total[$__range]))"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "0"}}, "options": {"graphMode": "none", "colorMode": "value"}},
    {"id": 24, "type": "stat", "title": "Errores MCP", "gridPos": {"h": 4, "w": 6, "x": 6, "y": 43}, "targets": [{"expr": "sum(increase(ada_mcp_calls_total{outcome=\"failure\"}[$__range]))"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "0"}}, "options": {"graphMode": "none", "colorMode": "background"}},
    {"id": 25, "type": "timeseries", "title": "MCP: llamadas por herramienta y resultado", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 47}, "targets": [{"expr": "sum by (tool, outcome) (rate(ada_mcp_calls_total[$__rate_interval])) * 60", "legendFormat": "{{tool}} · {{outcome}} / min"}], "fieldConfig": {"defaults": {"unit": "reqpm", "custom": {"showPoints": "never"}}}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 26, "type": "timeseries", "title": "MCP: latencia por herramienta", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 47}, "targets": [{"expr": "sum by (tool) (rate(ada_mcp_duration_seconds_sum[$__rate_interval])) / sum by (tool) (rate(ada_mcp_duration_seconds_count[$__rate_interval]))", "legendFormat": "{{tool}}"}], "fieldConfig": {"defaults": {"unit": "s", "decimals": 2, "custom": {"showPoints": "never"}}}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 27, "type": "row", "title": "RECURSOS DEL HOST Y JVM", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 55}},
    {"id": 28, "type": "timeseries", "title": "Memoria por componente, modelo, otros y libre", "gridPos": {"h": 10, "w": 24, "x": 0, "y": 56}, "targets": [{"expr": "ada_host_component_memory_bytes{component!=\"ollama\"}", "legendFormat": "{{component}}"}, {"expr": "ada_host_ollama_model_memory_bytes", "legendFormat": "modelo: {{model}}"}, {"expr": "clamp_min(ada_host_component_memory_bytes{component=\"ollama\"} - scalar(sum(ada_host_ollama_model_memory_bytes)), 0)", "legendFormat": "ollama proceso base"}, {"expr": "clamp_min(ada_host_system_memory_bytes{state=\"used\"} - scalar(sum(ada_host_component_memory_bytes)), 0)", "legendFormat": "otros"}, {"expr": "ada_host_system_memory_bytes{state=\"available\"}", "legendFormat": "libre"}], "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"fillOpacity": 55, "stacking": {"mode": "normal"}, "showPoints": "never"}}}, "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "lastNotNull", "max"]}, "tooltip": {"mode": "multi"}}},
    {"id": 29, "type": "timeseries", "title": "CPU de ADA y del sistema", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 66}, "targets": [{"expr": "process_cpu_usage * 100", "legendFormat": "ADA proceso (%)"}, {"expr": "system_cpu_usage * 100", "legendFormat": "Sistema (%)"}, {"expr": "system_load_average_1m", "legendFormat": "Load average 1m"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"showPoints": "never"}}}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 30, "type": "timeseries", "title": "Memoria JVM por área", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 66}, "targets": [{"expr": "sum by (id) (jvm_memory_used_bytes)", "legendFormat": "Usada · {{id}}"}, {"expr": "sum by (id) (jvm_memory_committed_bytes)", "legendFormat": "Comprometida · {{id}}"}], "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"showPoints": "never"}}}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 31, "type": "timeseries", "title": "Threads JVM y pool de tareas", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 74}, "targets": [{"expr": "jvm_threads_live_threads", "legendFormat": "Threads JVM"}, {"expr": "executor_active_threads", "legendFormat": "Executor activos"}, {"expr": "executor_pool_size_threads", "legendFormat": "Executor pool"}], "fieldConfig": {"defaults": {"unit": "short", "custom": {"showPoints": "never"}}}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 32, "type": "stat", "title": "Memoria host disponible", "gridPos": {"h": 4, "w": 6, "x": 12, "y": 74}, "targets": [{"expr": "ada_host_system_memory_bytes{state=\"available\"}"}], "fieldConfig": {"defaults": {"unit": "bytes", "decimals": 1, "noValue": "SIN DATOS"}}, "options": {"graphMode": "none", "colorMode": "value"}},
    {"id": 33, "type": "stat", "title": "Carga host 1m", "gridPos": {"h": 4, "w": 6, "x": 18, "y": 74}, "targets": [{"expr": "system_load_average_1m"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 2, "noValue": "SIN DATOS"}}, "options": {"graphMode": "none", "colorMode": "value"}}
  ],
