{
  "name": "ADA",
  "web_framework": "asgi",
  "ollama_url": "http://127.0.0.1:11434",
  "engine_provider": "ollama",
  "router_timeout": 8,
  "model_timeout": 50,
  "chat_timeout_seconds": 65,
  "folder_resolver_timeout": 4,
  "folder_probe_timeout": 0.75,
  "folder_max_probes": 40,
  "models": {
    "chat": "llama3.2:3b",
    "vision": "qwen2.5vl:3b",
    "router": "llama3.2:3b"
  },
  "base_dir": "~/GoogleDrive",
  "data_dir": "/home/fedemarkoo/Desktop/ADA_Data",
  "db_path": "/home/fedemarkoo/Desktop/ADA_Data/memory.db",
  "memory_encryption": false,
  "photo_root": "/home/fedemarkoo/GoogleDrive/Fotos",
  "photo_executor": "thread",
  "allowed_roots": [
    "/home/fedemarkoo/GoogleDrive",
    "/home/fedemarkoo/Desktop/ADA_Data",
    "/home/fedemarkoo/Desktop/Fotos",
    "/home/fedemarkoo/Desktop"
  ],
  "allowed_commands": [],
  "gmail_token_path": "~/.config/ada/gmail-token.json",
  "gmail_credential_name": "gmail_oauth",
  "gmail_client_secret_path": "~/.config/ada/google-client.json",
  "instagram_provider": "puppeteer",
  "instagram_user_id": "",
  "instagram_access_token": "",
  "instagram_publish_script": "",
  "instagram_profile_dir": "/home/fedemarkoo/.config/ada/instagram-profile",
  "model_catalog": [
    {
      "name": "llama3.2:1b",
      "roles": [
        "router",
        "fast"
      ],
      "quality_tier": "tiny",
      "min_ram_gb": 2,
      "description": "Ultrarrápido y liviano para clasificación de intents y tareas simples."
    },
    {
      "name": "llama3.2:3b",
      "roles": [
        "chat",
        "router"
      ],
      "quality_tier": "small",
      "min_ram_gb": 4,
      "description": "Equilibrio ideal entre velocidad y razonamiento para el día a día."
    },
    {
      "name": "qwen2.5:3b",
      "roles": [
        "chat",
        "router"
      ],
      "quality_tier": "small",
      "min_ram_gb": 4,
      "description": "Excelente seguimiento de instrucciones y código ligero."
    },
    {
      "name": "qwen2.5:7b",
      "roles": [
        "chat",
        "tools",
        "coding"
      ],
      "quality_tier": "medium",
      "min_ram_gb": 8,
      "description": "Potente modelo para tool-calling, código y razonamiento complejo."
    },
    {
      "name": "qwen2.5vl:3b",
      "roles": [
        "vision"
      ],
      "quality_tier": "small",
      "min_ram_gb": 6,
      "description": "Comprensión visual y OCR para fotos, documentos y capturas."
    },
    {
      "name": "deepseek-r1:8b",
      "roles": [
        "chat",
        "reasoning"
      ],
      "quality_tier": "medium",
      "min_ram_gb": 10,
      "description": "Capacidades avanzadas de razonamiento paso a paso (Chain of Thought)."
    },
    {
      "name": "nomic-embed-text",
      "roles": [
        "embedding"
      ],
      "quality_tier": "small",
      "min_ram_gb": 2,
      "description": "Modelo de embeddings de alto rendimiento para búsqueda semántica."
    }
  ],
  "model_policy": {
    "chat": {
      "preferred": "qwen2.5:7b",
      "fallbacks": [
        "qwen3:8b",
        "deepseek-r1:8b",
        "llama3.2:3b"
      ]
    },
    "router": {
      "preferred": "llama3.2:3b",
      "fallbacks": []
    },
    "reasoning": {
      "preferred": "deepseek-r1:8b",
      "fallbacks": []
    },
    "coding": {
      "preferred": "qwen2.5:7b",
      "fallbacks": []
    },
    "tools": {
      "preferred": "qwen2.5:7b",
      "fallbacks": []
    },
    "vision": {
      "preferred": null,
      "fallbacks": []
    }
  },
  "confirm_risky": true,
  "privacy_default": "normal",
  "local_runtime": {
    "provider": "ollama",
    "auto_start": true,
    "auto_pull": false
  },
  "telegram": {
    "enabled": true,
    "allowed_chat_ids": [],
    "inbox": "~/Desktop/ADA_Data/telegram_inbox"
  },
  "event_rules": {
    "filesystem.file_created": {
      "action": "analyze_photo",
      "extensions": [
        ".jpg",
        ".jpeg",
        ".png",
        ".nef",
        ".arw",
        ".cr2",
        ".dng"
      ],
      "payload": {
        "vision": false
      },
      "auto_execute": true,
      "complexity": 4
    }
  },
  "ollama_num_thread": 6,
  "ollama_num_ctx": 4096,
  "ollama_keep_alive": "10m",
  "cpu_limit_percent": 75,
  "ollama_temperature": 0.2,
  "model_selection_mode": "hybrid",
  "adaptive_models": false,
  "chat_max_tokens": 768
}