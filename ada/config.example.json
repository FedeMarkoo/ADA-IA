{
  "name": "ADA",
  "web_framework": "asgi",
  "ollama_url": "http://127.0.0.1:11434",
  "engine_provider": "ollama",
  "engine_priority": ["ollama", "gemini", "groq"],
  "gemini_model": "gemini-3.6-flash",
  "groq_model": "llama-3.3-70b-versatile",
  "timeout_profile": "patient",
  "router_timeout": 30,
  "model_timeout": 300,
  "chat_timeout_seconds": 900,
  "food_advisor_timeout": 180,
  "folder_resolver_timeout": 4,
  "folder_probe_timeout": 0.75,
  "folder_max_probes": 40,
  "models": {
    "chat": "llama3.2:3b",
    "vision": "qwen2.5vl:3b",
    "router": "llama3.2:3b"
  },
  "base_dir": "~/GoogleDrive",
  "data_dir": "~/Desktop/ADA_Data",
  "db_path": "~/Desktop/ADA_Data/memory.db",
  "memory_encryption": false,
  "photo_root": "~/GoogleDrive/Fotos",
  "photo_executor": "thread",
  "allowed_roots": [
    "~/GoogleDrive",
    "~/Desktop/ADA_Data",
    "~/Desktop/Fotos",
    "~/Desktop"
  ],
  "allowed_commands": [],
  "gmail_token_path": "~/.config/ada/gmail-token.json",
  "gmail_credential_name": "gmail_oauth",
  "gmail_client_secret_path": "~/.config/ada/google-client.json",
  "instagram_provider": "puppeteer",
  "instagram_user_id": "",
  "instagram_access_token": "",
  "instagram_publish_script": "",
  "instagram_profile_dir": "~/.config/ada/instagram-profile",
  "model_catalog": [
    {
      "name": "llama3.2:3b",
      "roles": ["chat", "router"],
      "quality_tier": "small",
      "min_ram_gb": 4
    },
    {
      "name": "qwen2.5vl:3b",
      "roles": ["vision"],
      "quality_tier": "small",
      "min_ram_gb": 6
    }
  ],
  "model_policy": {
    "chat": {
      "preferred": "llama3.2:3b",
      "fallbacks": []
    },
    "vision": {
      "preferred": "qwen2.5vl:3b",
      "fallbacks": []
    },
    "router": {
      "preferred": "llama3.2:3b",
      "fallbacks": []
    }
  },
  "confirm_risky": true,
  "privacy_default": "normal",
  "local_runtime": {
    "provider": "ollama",
    "auto_start": true,
    "auto_pull": false
  },
  "telegram": {
    "enabled": false,
    "poll_seconds": 2,
    "request_timeout_seconds": 900,
    "typing_indicator": true,
    "typing_interval_seconds": 4,
    "allowed_chat_ids": [],
    "inbox": "~/Desktop/ADA_Data/telegram_inbox"
  },
  "triggers": {
    "removable-device": {"enabled": false},
    "calendar": {"enabled": false},
    "cron": {
      "enabled": false,
      "calendar_weekly_digest": {
        "enabled": false,
        "hour": 8,
        "minute": 0,
        "chat_id": ""
      }
    },
    "webhook": {"enabled": false}
  },
  "ollama_keep_alive": "2m",
  "ollama_auto_unload": true,
  "ollama_idle_unload_seconds": 300,
  "event_rules": {
    "filesystem.file_created": {
      "action": "analyze_photo",
      "extensions": [
        ".jpg",
        ".jpeg",
        ".png",
        ".nef",
        ".arw",
        ".cr2",
        ".dng"
      ],
      "payload": {
        "vision": false
      },
      "auto_execute": true,
      "complexity": 4
    }
  }
}
