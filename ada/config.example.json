{
  "name": "ADA",
  "web_framework": "asgi",
  "ollama_url": "http://127.0.0.1:11434",
  "ollama_backend": "litellm",
  "local_model_exclusive_mode": true,
  "local_model_switch_policy": "wait",
  "local_model_switch_timeout_seconds": 30,
  "local_model_restore_previous_on_failure": true,
  "engine_provider": "ollama",
  "engine_priority": ["ollama", "gemini", "groq"],
  "gemini_model": "gemini-3.6-flash",
  "groq_model": "llama-3.3-70b-versatile",
  "timeout_profile": "patient",
  "router_timeout": 30,
  "model_timeout": 300,
  "chat_timeout_seconds": 900,
  "food_advisor_timeout": 180,
  "folder_resolver_timeout": 4,
  "folder_probe_timeout": 0.75,
  "folder_max_probes": 40,
  "models": {
    "chat": "llama3.2:3b",
    "vision": "qwen2.5vl:3b",
    "router": "llama3.2:3b"
  },
  "base_dir": "~/GoogleDrive",
  "data_dir": "~/Desktop/ADA_Data",
  "db_path": "~/Desktop/ADA_Data/memory.db",
  "memory_encryption": false,
  "memory_compaction_enabled": true,
  "memory_compaction_threshold_messages": 100,
  "memory_compaction_keep_messages": 40,
  "memory_compaction_max_summary_chars": 6000,
  "photo_root": "~/GoogleDrive/Fotos",
  "photo_executor": "thread",
  "allowed_roots": [
    "~/GoogleDrive",
    "~/Desktop/ADA_Data",
    "~/Desktop/Fotos",
    "~/Desktop"
  ],
  "allowed_commands": [],
  "gmail_token_path": "~/.config/ada/gmail-token.json",
  "gmail_credential_name": "gmail_oauth",
  "gmail_client_secret_path": "~/.config/ada/google-client.json",
  "instagram_provider": "puppeteer",
  "instagram_user_id": "",
  "instagram_access_token": "",
  "instagram_publish_script": "",
  "instagram_profile_dir": "~/.config/ada/instagram-profile",
  "model_catalog": [
    {
      "name": "llama3.2:3b",
      "roles": ["chat", "router"],
      "quality_tier": "small",
      "min_ram_gb": 4
    },
    {
      "name": "qwen2.5vl:3b",
      "roles": ["vision"],
      "quality_tier": "small",
      "min_ram_gb": 6
    }
  ],
  "model_policy": {
    "chat": {
      "preferred": "llama3.2:3b",
      "fallbacks": []
    },
    "vision": {
      "preferred": "qwen2.5vl:3b",
      "fallbacks": []
    },
    "router": {
      "preferred": "llama3.2:3b",
      "fallbacks": []
    }
  },
  "provider_router": {
    "sort": "balanced",
    "providers": [
      {"name": "ollama", "local": true, "priority": 10, "latency_ms": 150},
      {"name": "gemini", "priority": 4, "price_per_million_tokens": 0, "latency_ms": 800},
      {"name": "openrouter", "priority": 2, "price_per_million_tokens": 1, "latency_ms": 900}
    ]
  },
  "context_policy": {
    "router": {"token_budget": 4096},
    "chat": {"token_budget": 8192},
    "coding": {"token_budget": 16384},
    "reasoning": {"token_budget": 24576},
    "tools": {"token_budget": 8192}
  },
  "update": {
    "enabled": false,
    "auto_pull": false,
    "restart_on_update": false,
    "telegram_chat_id": "",
    "branch": "main",
    "check_interval_seconds": 3600,
    "state_path": "~/Desktop/ADA_Data/runtime/update.json"
  },
  "confirm_risky": true,
  "privacy_default": "normal",
  "local_runtime": {
    "provider": "ollama",
    "auto_start": true,
    "auto_pull": false,
    "url": "http://127.0.0.1:8080",
    "binary": "",
    "model_path": "~/Desktop/ADA_Data/models/model.gguf",
    "model_alias": "ada-local",
    "mmproj_path": "",
    "host": "127.0.0.1",
    "port": 8080
  },
  "telegram": {
    "enabled": false,
    "poll_seconds": 2,
    "request_timeout_seconds": 900,
    "typing_indicator": true,
    "typing_interval_seconds": 4,
    "allowed_chat_ids": [],
    "inbox": "~/Desktop/ADA_Data/telegram_inbox"
  },
  "triggers": {
    "removable-device": {"enabled": false},
    "calendar": {"enabled": false},
    "cron": {
      "enabled": false,
      "calendar_weekly_digest": {
        "enabled": false,
        "hour": 8,
        "minute": 0,
        "chat_id": ""
      },
      "sarmiento_status": {
        "enabled": false,
        "hour": 13,
        "minute": 0,
        "required_location": "work",
        "chat_id": ""
      }
    },
    "webhook": {"enabled": false}
  },
  "presence_path": "~/Desktop/ADA_Data/runtime/presence.json",
  "transport": {
    "api_base_url": "https://api-transporte.buenosaires.gob.ar",
    "service_alerts_path": "/trenes/serviceAlerts",
    "sarmiento_route_id": "Sarmiento",
    "timeout_seconds": 8
  },
  "ollama_keep_alive": "2m",
  "ollama_auto_unload": true,
  "ollama_idle_unload_seconds": 300,
  "event_rules": {
    "filesystem.file_created": {
      "action": "analyze_photo",
      "extensions": [
        ".jpg",
        ".jpeg",
        ".png",
        ".nef",
        ".arw",
        ".cr2",
        ".dng"
      ],
      "payload": {
        "vision": false
      },
      "auto_execute": true,
      "complexity": 4
    }
  }
}
