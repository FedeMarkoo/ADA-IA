[Unit]
Description=ADA local image deployer
Wants=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@ADA_USER@
Group=@ADA_GROUP@
SupplementaryGroups=docker 10001
WorkingDirectory=@ADA_DIR@
Environment=HOME=@ADA_HOME@
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/docker info
ExecStart=/usr/bin/env python3 @ADA_DIR@/scripts/deployment/local-deployer.py --compose @ADA_DIR@/compose.yaml --env-file @ADA_ENV_FILE@ --interval 300
Restart=always
RestartSec=15
NoNewPrivileges=true
TimeoutStartSec=0
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
